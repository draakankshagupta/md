{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {"source": "/ace-my-path", "destination": "/ace-my-path-page", "permanent": true},
    {"source": "/books", "destination": "/books-page", "permanent": true},
    {"source": "/scholarly-activity", "destination": "/research", "permanent": true},
    {"source": "/testimonials", "destination": "/testimonials-and-reviews", "permanent": true},
    {"source": "/curriculum-vitae", "destination": "/#ag-about", "permanent": true},
    {"source": "/media", "destination": "/#ag-media", "permanent": true},
    {"source": "/mdhelponline", "destination": "/#ag-service", "permanent": true}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"}
      ]
    }
  ]
}
